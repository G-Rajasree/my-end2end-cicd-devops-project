aws_region = "us-east-1"

# Get latest Ubuntu 22.04 AMI:
# aws ec2 describe-images --owners 099720109477 \
#   --filters "Name=name,Values=ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*" \
#   --query "sort_by(Images, &CreationDate)[-1].ImageId" --output text --region us-east-1
# Paste the output above here:
ami_id = "ami-xxxxxxxxxxxxxxxxx"

# t3.medium minimum for jenkins-master and build-slave (Jenkins needs 2GB+ RAM)
# ansible can run on t3.micro since it only runs playbooks
instance_type = "t3.medium"

key_name              = "your-key-pair-name"
vpc_cidr              = "10.1.0.0/16"
public_subnet_01_cidr = "10.1.1.0/24"
public_subnet_02_cidr = "10.1.2.0/24"

# Your public IP — run: curl -s ifconfig.me
# Restricts SSH, Jenkins (8080), and EKS API access to only your machine
allowed_cidr = "<your-public-ip>/32"
